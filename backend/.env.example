PORT=8080
CORS_ORIGIN=http://localhost:5173
# Postgres (e.g. Aiven). Never commit the real value.
DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/defaultdb
# Provider CA certificate. TLS is always verified.
DATABASE_CA_CERT_PATH=./secrets/aiven-ca.pem
ADMIN_WALLET_ADDRESSES=
POLYGON_RPC_URL=
MESSAGE_VERIFIER_ADDRESS=
AUTH_DOMAIN=localhost:5173
AUTH_URI=http://localhost:5173
AUTH_ALLOWED_CHAIN_IDS=80002
AUTH_NONCE_TTL_SECONDS=300
SESSION_TTL_HOURS=168
TRUST_PROXY=
